<% if flash[:alert] %>
  <div class="alert alert-danger">
    <%= flash[:alert] %>
  </div>
<% end %>

<% if @user.errors.any? %>
  <div class="alert alert-danger">
    <h4><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</h4>
    <ul>
      <% @user.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @user, url: create_user_by_admin_path, data: { controller: "multi-stepform" } do |f| %>
  <div data-multi-stepform-target="step">
    <h5>Basic Info</h5>
    <%= render partial: 'basic_info', locals: { f: f } %>
    <div class="text-end mt-3">
      <button type="button" class="btn btn-primary" data-action="click->multi-stepform#next">Next</button>
    </div>
  </div>

  <div data-multi-stepform-target="step" hidden>
    <h5>User Info Details</h5>
    <%= f.fields_for :user_info do |uif| %>
      <%= render partial: 'user_info', locals: { uif: uif } %>
    <% end %>
    <div class="text-end mt-3">
      <button type="button" class="btn btn-secondary" data-action="click->multi-stepform#previous">Back</button>
      <button type="button" class="btn btn-primary" data-action="click->multi-stepform#next">Next</button>
    </div>
  </div>

  <div data-multi-stepform-target="step" hidden>
    <h5>Job Employment</h5>
    <%= f.fields_for :job_employments do |job| %>
      <%= render partial: 'job_employment', locals: { f: job } %>
    <% end %>
    <div class="text-end mt-3">
      <button type="button" class="btn btn-secondary" data-action="click->multi-stepform#previous">Back</button>
      <button type="button" class="btn btn-primary" data-action="click->multi-stepform#next">Next</button>
    </div>
  </div>

  <div data-multi-stepform-target="step" hidden>
    <h5>Asset Details</h5>
    <% @user.asset_details.each do |asset| %>
      <%= f.fields_for :asset_details, asset do |asset_form| %>
        <%= render partial: 'asset_details', locals: { f: asset_form } %>
      <% end %>
    <% end %>
    <div class="text-end mt-3">
      <button type="button" class="btn btn-secondary" data-action="click->multi-stepform#previous">Back</button>
      <button type="button" class="btn btn-primary" data-action="click->multi-stepform#next">Next</button>
    </div>
  </div>

  <div data-multi-stepform-target="step" hidden>
    <h5>Bank Details</h5>
    <% @user.bank_details.each do |bank| %>
      <%= f.fields_for :bank_details, bank do |bank_form| %>
        <%= render partial: 'bank_details', locals: { f: bank_form } %>
      <% end %>
    <% end %>

    
    <div class="text-end mt-3">
      <button type="button" class="btn btn-secondary" data-action="click->multi-stepform#previous">Back</button>
      <%= f.submit "Create User", class: "btn btn-success" %>
    </div>
  </div>
<% end %>
